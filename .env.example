# Copy to `.env` and fill in your own values. `.env` is git-ignored.
# See docs/SNOWFLAKE_SETUP.md for where to find each Snowflake value.

# Which connection the app uses unless a test case names another one.
DEFAULT_CONNECTION=snowflake

# ---------------------------------------------------------------- Snowflake
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
# Account identifier — see docs/SNOWFLAKE_SETUP.md step 1. Examples:
#   ab12345.ap-south-1.aws        (locator form)
#   MYORG-MYACCOUNT               (org-account form)
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_WAREHOUSE=DQ_WH
SNOWFLAKE_DATABASE=INSURANCE_AUTOMATION
SNOWFLAKE_SCHEMA=DQ
SNOWFLAKE_ROLE=ACCOUNTADMIN
# If your trial enforces MFA, leave PASSWORD blank and uncomment the next line:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# --------------------------------------------------------- MSSQL (optional)
# Leave unset to run Snowflake-only. Fill in to enable cross-database
# source-to-target validation (Snowflake source vs MSSQL target, or vice versa).
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password
# MSSQL_DATABASE=INSURANCE_AUTOMATION
# MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ------------------------------------------------------------------- App
DQ_BATCH_ID=BATCH_20260901_001
DQ_APP_USER=analyst
